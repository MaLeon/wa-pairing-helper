{
  "name": "wa-pairing-helper",
  "version": "0.1.0",
  "description": "Account-scoped WhatsApp pairing-code helper for OpenClaw",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "openclaw-wa-pair": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "patches",
    "scripts"
  ],
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaLeon/wa-pairing-helper.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "verify:baseline": "node scripts/verify-baseline.mjs"
  },
  "dependencies": {
    "baileys": "7.0.0-rc13",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
